    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "lightningcss": "^1.33.0",
    "terser": "^5.49.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
